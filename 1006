local function EOSVMQQ_fake_script() -- TextLabel.LocalScript 
	local script = Instance.new('LocalScript', TextLabel)

	local label = script.Parent
	local originalText = label.Text
	local corruptChars = {"█", "▓", "▒", "░", "#", "@", "!", "?", "%", "&", "X", "0", "1"}
	local RunService = game:GetService("RunService")
	
	local function randomCorrupt(text)
		local result = ""
		for i = 1, #text do
			if math.random() < 0.5 then
				result = result .. corruptChars[math.random(1, #corruptChars)]
			else
				result = result .. text:sub(i, i)
			end
		end
		return result
	end
	
	local function runCorruptCycle()
		local cycles = 0
		local maxCycles = 18
		local lastTick = 0
		local connection
	
		connection = RunService.Heartbeat:Connect(function()
			if tick() - lastTick < 0.07 then return end
			lastTick = tick()
			cycles = cycles + 1
	
			if cycles >= maxCycles then
				label.Text = originalText
				connection:Disconnect()
			else
				label.Text = randomCorrupt(originalText)
			end
		end)
	end
	
	-- Run on loop: corrupt every few seconds
	while true do
		task.wait(3)
		runCorruptCycle()
	end
end
coroutine.wrap(EOSVMQQ_fake_script)()
local function JSPUD_fake_script() -- input.LocalScript 
	local script = Instance.new('LocalScript', input)

	local input = script.Parent
	local RunService = game:GetService("RunService")
	
	local typeSound = Instance.new("Sound")
	typeSound.SoundId = "rbxassetid://140036379967302"
	typeSound.Volume = 0.5
	typeSound.Parent = input
	
	local backspaceSound = Instance.new("Sound")
	backspaceSound.SoundId = "rbxassetid://139377468173728"
	backspaceSound.Volume = 0.5
	backspaceSound.Parent = input
	
	local lastText = input.Text
	local lastPlayed = 0
	
	input:GetPropertyChangedSignal("Text"):Connect(function()
		local newText = input.Text
		if tick() - lastPlayed > 0.05 then
			lastPlayed = tick()
			if #newText < #lastText then
				-- text got shorter = backspace
				backspaceSound:Play()
			else
				-- text got longer = typing
				typeSound:Play()
			end
		end
		lastText = newText
	end)
	
end
