	local function tweenTo(target, speed)
		speed = speed or TWEEN_SPEED
		local root = getRoot()
		if not root then return end
		local targetCFrame = typeof(target) == "CFrame" and target or CFrame.new(target)
		local dist = (root.Position - targetCFrame.Position).Magnitude
		local duration = math.max(dist / speed, 0.1)
		local tween = TweenService:Create(
			root,
			TweenInfo.new(duration, Enum.EasingStyle.Linear),
			{ CFrame = targetCFrame }
		)
		tween:Play()
		tween.Completed:Wait()
	end
	
	local function returnToDock()
		local root = getRoot()
		local bestDock = DOCK_POSITIONS[1]
		if root then
			local bestDist = math.huge
			for _, pos in ipairs(DOCK_POSITIONS) do
				local d = (root.Position - pos).Magnitude
				if d < bestDist then bestDist = d; bestDock = pos end
			end
		end
		tweenTo(bestDock, ARROW_TWEEN_SPEED)
		task.wait(0.5)
	end
	
