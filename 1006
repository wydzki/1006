		while not appeared and (os.clock() - start < timeout) and fishing and not isSelling do
			task.wait()
		end
		conn:Disconnect()
		return appeared or (fishingUI and fishingUI.Enabled)
	end
	
	-- =====================================================================
	-- ARROW ESP
	-- =====================================================================
	
	local INTERACTABLE_FOLDER = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Interactable")
	local ARROW_COLOR = Color3.fromRGB(0, 150, 255)
	
	local espFolder = Instance.new("Folder")
	espFolder.Name   = "ArrowESP"
	espFolder.Parent = PlayerGui
	
	local function clearESP()
		for _, v in ipairs(espFolder:GetChildren()) do v:Destroy() end
	end
	
	local function makeESP(model, handle)
		if not model.Parent then return end
		local highlight = Instance.new("Highlight")
		highlight.Adornee          = model
		highlight.DepthMode        = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillColor        = ARROW_COLOR
		highlight.FillTransparency = 0.65
		highlight.OutlineColor     = ARROW_COLOR
		highlight.Parent           = espFolder
	
		local billboard = Instance.new("BillboardGui")
		billboard.Adornee     = handle
		billboard.Size        = UDim2.fromOffset(180, 40)
		billboard.StudsOffset = Vector3.new(0, 3, 0)
		billboard.AlwaysOnTop = true
		billboard.Parent      = espFolder
	
		local label = Instance.new("TextLabel")
		label.Size                   = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text                   = "Stand Arrow"
		label.TextColor3             = ARROW_COLOR
		label.TextStrokeTransparency = 0
		label.TextSize               = 14
		label.Font                   = Enum.Font.GothamBold
		label.Parent                 = billboard
	end
	
	local function getArrowTargets()
		local result = {}
		if not INTERACTABLE_FOLDER then return result end
		for _, obj in ipairs(INTERACTABLE_FOLDER:GetChildren()) do
			if obj.Name == "Stand Arrow" then
				local handle = obj:FindFirstChild("Handle")
					or obj:FindFirstChildWhichIsA("BasePart", true)
				if handle then
					table.insert(result, { model = obj, handle = handle })
				end
			end
		end
		return result
	end
	
	local function updateESP()
		clearESP()
		if not arrowFarming then return end
		for _, t in ipairs(getArrowTargets()) do
			makeESP(t.model, t.handle)
		end
	end
	
	task.spawn(function()
		while true do
			updateESP()
			task.wait(0.5)
		end
	end)
	
	-- =====================================================================
	-- PROXIMITY PROMPT E-SPAM
	-- =====================================================================
	
	local function spamEOnTarget(target)
		local prompt = target.model:FindFirstChildWhichIsA("ProximityPrompt", true)
			or target.handle:FindFirstChildWhichIsA("ProximityPrompt", true)
		if not prompt or not prompt.Enabled then return false end
		for _ = 1, 5 do
			VirtualInputManager:SendKeyEvent(true,  Enum.KeyCode.E, false, nil)
			task.wait(0.05)
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, nil)
			task.wait(0.05)
		end
		return true
	end
	
	-- =====================================================================
	-- ARROW FARM CYCLE
	-- =====================================================================
	
	local function arrowFarmCycle(skipCollect)
		arrowFarming = true
		local slotted = false
	
		if itemExists("Stand Arrow") then
			slotEquipArrow()
			slotted = true
		end
	
		-- FIX: tryUseArrow no longer checks arrow count — it loops forever,
		-- equipping and using one arrow per iteration until arrowFarming stops.
		local function tryUseArrow()
			if not isArrowEquipped() then
				equipArrow()
				local t0 = os.clock()
				while arrowFarming and not isArrowEquipped() and os.clock() - t0 < 2 do
					task.wait(0.1)
				end
			end
			if not isArrowEquipped() then return end
			useArrow()
			task.wait(1)
			storeStand()
			task.wait(0.5)
		end
	
		if skipCollect then
			-- usearrows command: keep using until stopped, regardless of count
			while arrowFarming do
				if getItemCount("Stand Arrow") > 0 then
					tryUseArrow()
				else
					task.wait(0.5)
				end
			end
		else
			while arrowFarming do
				local targets = getArrowTargets()
				if #targets == 0 then
					if getItemCount("Stand Arrow") > 0 then
						tryUseArrow()
					else
						task.wait(1)
					end
					continue
				end
				for _, target in ipairs(targets) do
					if not arrowFarming then break end
					if not target.handle.Parent then continue end
					tweenTo(target.handle.Position)
					if not arrowFarming then break end
					task.wait(0.2)
					local hadCount = getItemCount("Stand Arrow")
					spamEOnTarget(target)
					task.wait(0.5)
					if not arrowFarming then break end
					local newCount = getItemCount("Stand Arrow")
					if newCount > 0 and not slotted then
						slotEquipArrow()
						slotted = true
					end
					if newCount > hadCount then
						tryUseArrow()
					end
				end
			end
		end
	
		if not arrowFarming then
			clearESP()
			return
		end
	
		returnToDock()
		arrowFarming = false
		clearESP()
	
		if fishing then
			if farmThread then task.cancel(farmThread) end
			farmThread = task.spawn(fishCycle)
		end
	end
	
	local function useArrowsCycle() arrowFarmCycle(true)  end
	local function startArrowFarm() arrowFarmCycle(false) end
	
	-- =====================================================================
	-- FISHING CYCLE
	-- =====================================================================
	
	-- forward declare so arrowFarmCycle can reference it
	fishCycle = function()
		while fishing do
			if getCameraCount() > CAMERA_THRESHOLD then
				fishing = false
				createGlowLabel("camera threshold hit — switching to arrow farm", Color3.fromRGB(0, 150, 255), Color3.fromRGB(100, 200, 255))
				task.spawn(startArrowFarm)
				return
			end
	
			while isSelling and fishing do task.wait(0.5) end
			if not ensureEquipped() then task.wait(1); continue end
	
			castRod()
			local uiAppeared = waitForFishingUI(UI_TIMEOUT)
			if not fishing then break end
	
			if not uiAppeared then
				equipRod(); task.wait(RE_CAST_DELAY)
				continue
			end
	
			local spamStart = os.clock()
			while fishing and not isSelling and isFishingUIActive() and (os.clock() - spamStart < MAX_SPAM_TIME) do
				spamAction()
			end
	
			if not fishing then break end
			equipRod(); task.wait(RE_CAST_DELAY)
		end
	end
	
	-- =====================================================================
	-- STW FARM CYCLE
	-- =====================================================================
	
	local function stwFarmCycle()
		stwFarming = true
	
		while stwFarming do
	
			-- Phase 1: fish until 9 cameras
			createGlowLabel("STW: fishing for cameras...", Color3.fromRGB(0, 150, 255), Color3.fromRGB(100, 200, 255))
			while stwFarming and getCameraCount() < STW_CAMERA_TARGET do
				while isSelling and stwFarming do task.wait(0.5) end
				if not stwFarming then break end
				if not ensureEquipped() then task.wait(1); continue end
				castRod()
				local fishingUI = PlayerGui:WaitForChild("FishingUI", 2)
				local uiAppeared = false
				if fishingUI then
					if fishingUI.Enabled then
						uiAppeared = true
					else
						local appeared = false
						local conn = fishingUI:GetPropertyChangedSignal("Enabled"):Connect(function()
							if fishingUI.Enabled then appeared = true end
						end)
						local t0 = os.clock()
						while not appeared and stwFarming and (os.clock() - t0 < UI_TIMEOUT) do task.wait() end
						conn:Disconnect()
						uiAppeared = appeared or fishingUI.Enabled
					end
				end
				if not stwFarming then break end
				if not uiAppeared then equipRod(); task.wait(RE_CAST_DELAY); continue end
				local spamStart = os.clock()
				while stwFarming and not isSelling and isFishingUIActive() and (os.clock() - spamStart < MAX_SPAM_TIME) do
					spamAction()
				end
				if not stwFarming then break end
				equipRod(); task.wait(RE_CAST_DELAY)
			end
	
			if not stwFarming then break end
			unequipRod()
			createGlowLabel("STW: collecting + using 50 arrows...", Color3.fromRGB(0, 150, 255), Color3.fromRGB(100, 200, 255))
	
			-- Phase 2: collect + use 50 arrows
			arrowFarming = true
			local slotted = itemExists("Stand Arrow")
			if slotted then slotEquipArrow() end
	
			local function stwTryUseArrow()
				if not isArrowEquipped() then
					equipArrow()
					local t0 = os.clock()
					while stwFarming and arrowFarming and not isArrowEquipped() and os.clock() - t0 < 2 do
						task.wait(0.1)
					end
				end
				if not isArrowEquipped() then return end
				useArrow(); task.wait(1)
				storeStand(); task.wait(0.5)
			end
	
			local usesCompleted = 0
			while stwFarming and usesCompleted < STW_ARROW_TARGET do
				local targets = getArrowTargets()
				if #targets == 0 then
					if getItemCount("Stand Arrow") > 0 then
						stwTryUseArrow(); usesCompleted += 1
					else
						task.wait(1)
					end
					continue
				end
				for _, target in ipairs(targets) do
					if not stwFarming or usesCompleted >= STW_ARROW_TARGET then break end
					if not target.handle.Parent then continue end
					tweenTo(target.handle.Position)
					if not stwFarming then break end
					task.wait(0.2)
					local hadCount = getItemCount("Stand Arrow")
					spamEOnTarget(target)
					task.wait(0.5)
					if not stwFarming then break end
					local newCount = getItemCount("Stand Arrow")
					if newCount > 0 and not slotted then slotEquipArrow(); slotted = true end
					if newCount > hadCount then stwTryUseArrow(); usesCompleted += 1 end
				end
			end
	
			arrowFarming = false
			clearESP()
			if not stwFarming then break end
	
			-- Phase 3: equip The World + use cameras
			createGlowLabel("STW: using cameras...", Color3.fromRGB(0, 150, 255), Color3.fromRGB(100, 200, 255))
			slotEquipCamera(); task.wait(0.3)
			equipTheWorld(); task.wait(0.5)
			while stwFarming and getCameraCount() > 0 do
				equipCamera(); task.wait(0.5)
				useCamera(); task.wait(0.5)
				createOutputLabel("  cameras remaining: " .. getCameraCount(), Color3.fromRGB(150, 150, 150))
			end
	
			if not stwFarming then break end
	
			-- Phase 4: return to dock and repeat
			createGlowLabel("STW: returning to dock...", Color3.fromRGB(0, 150, 255), Color3.fromRGB(100, 200, 255))
			returnToDock()
			task.wait(0.5)
		end
	
		arrowFarming = false
		clearESP()
		stwFarming = false
		createGlowLabel("STW farm stopped.", Color3.fromRGB(180, 0, 0), Color3.fromRGB(255, 80, 80))
	end
	
	-- =====================================================================
	-- TERMINAL COMMAND HANDLER
	-- =====================================================================
	
	local function handleCommand(text)
		local cmd = text:lower()
	
		if cmd == "clear" or cmd == "cls" then
			clearOutput()
			createGlowLabel("cleared!", Color3.fromRGB(0, 200, 100), Color3.fromRGB(180, 255, 220))
	
		elseif cmd == "help" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			createOutputLabel("------------------------------", Color3.fromRGB(60, 60, 60))
			createGlowLabel("Available commands:", Color3.fromRGB(180, 180, 0), Color3.fromRGB(255, 255, 0))
			createOutputLabel("  help             - shows this help menu")
			createOutputLabel("  clear / cls      - clears the terminal")
			createOutputLabel("  1006             - displays info about 1006")
			createOutputLabel("  own              - shows ownership info")
			createOutputLabel("  autofish         - starts auto fishing")
			createOutputLabel("  autofish off     - stops auto fishing")
			createOutputLabel("  autosell         - sells all fish now")
			createOutputLabel("  arrowfarm        - starts stand arrow farm")
			createOutputLabel("  arrowfarm off    - stops stand arrow farm")
			createOutputLabel("  usearrows        - uses arrows from inventory")
			createOutputLabel("  stwfarm          - starts STW farm cycle")
			createOutputLabel("  stwfarm off      - stops STW farm cycle")
			createOutputLabel("  eject            - destroys the terminal GUI")
			createOutputLabel("------------------------------", Color3.fromRGB(60, 60, 60))
	
		elseif cmd == "1006" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			createOutputLabel("------------------------------", Color3.fromRGB(60, 60, 60))
			createGlowLabel("[ 1006 ]", Color3.fromRGB(0, 180, 50), Color3.fromRGB(0, 255, 70))
			createOutputLabel("SCP-1006 Terminal System")
			createOutputLabel("Version 2.0.0")
			createGlowLabel("Status: ONLINE", Color3.fromRGB(0, 180, 50), Color3.fromRGB(0, 255, 70))
			createOutputLabel("------------------------------", Color3.fromRGB(60, 60, 60))
	
		elseif cmd == "own" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			createOutputLabel("------------------------------", Color3.fromRGB(60, 60, 60))
			createGlowLabel("Ownership Info:", Color3.fromRGB(180, 180, 0), Color3.fromRGB(255, 255, 0))
			createOutputLabel("  User: " .. localPlayer.Name)
			createOutputLabel("  UserId: " .. localPlayer.UserId)
			createGlowLabel("  Access Level: root", Color3.fromRGB(200, 100, 0), Color3.fromRGB(255, 180, 50))
			createOutputLabel("------------------------------", Color3.fromRGB(60, 60, 60))
	
		elseif cmd == "autofish" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			if fishing then
				createGlowLabel("autofish is already on.", Color3.fromRGB(180, 180, 0), Color3.fromRGB(255, 255, 100))
			else
				fishing = true
				if farmThread then task.cancel(farmThread) end
				farmThread = task.spawn(fishCycle)
				startSellTimer()
				createGlowLabel("autofish on", Color3.fromRGB(0, 180, 50), Color3.fromRGB(0, 255, 70))
			end
	
		elseif cmd == "autofish off" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			if not fishing then
				createGlowLabel("autofish is already off.", Color3.fromRGB(180, 180, 0), Color3.fromRGB(255, 255, 100))
			else
				fishing = false
				if farmThread then task.cancel(farmThread); farmThread = nil end
				if sellThread then task.cancel(sellThread); sellThread = nil end
				createGlowLabel("autofish stopped.", Color3.fromRGB(180, 0, 0), Color3.fromRGB(255, 80, 80))
			end
	
		elseif cmd == "autosell" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			if isSelling then
				createGlowLabel("already selling...", Color3.fromRGB(180, 180, 0), Color3.fromRGB(255, 255, 100))
			else
				createGlowLabel("selling all items now...", Color3.fromRGB(0, 150, 255), Color3.fromRGB(100, 200, 255))
				task.spawn(function()
					sellAllItems()
					createGlowLabel("sell complete!", Color3.fromRGB(0, 180, 50), Color3.fromRGB(0, 255, 70))
				end)
			end
	
		elseif cmd == "arrowfarm" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			if arrowFarming then
				createGlowLabel("arrowfarm is already running.", Color3.fromRGB(180, 180, 0), Color3.fromRGB(255, 255, 100))
			else
				if fishing then
					fishing = false
					if farmThread then task.cancel(farmThread); farmThread = nil end
				end
				createGlowLabel("arrowfarm started.", Color3.fromRGB(0, 150, 255), Color3.fromRGB(100, 200, 255))
				task.spawn(startArrowFarm)
			end
	
		elseif cmd == "arrowfarm off" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			if not arrowFarming then
				createGlowLabel("arrowfarm is not running.", Color3.fromRGB(180, 180, 0), Color3.fromRGB(255, 255, 100))
			else
				arrowFarming = false
				clearESP()
				createGlowLabel("arrowfarm stopped.", Color3.fromRGB(180, 0, 0), Color3.fromRGB(255, 80, 80))
			end
	
		elseif cmd == "usearrows" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			if arrowFarming then
				createGlowLabel("already running arrow cycle.", Color3.fromRGB(180, 180, 0), Color3.fromRGB(255, 255, 100))
			else
				createGlowLabel("using arrows from inventory...", Color3.fromRGB(0, 150, 255), Color3.fromRGB(100, 200, 255))
				task.spawn(useArrowsCycle)
			end
	
		elseif cmd == "stwfarm" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			if stwFarming then
				createGlowLabel("STW farm is already running.", Color3.fromRGB(180, 180, 0), Color3.fromRGB(255, 255, 100))
			else
				fishing = false; arrowFarming = false; clearESP()
				if farmThread then task.cancel(farmThread); farmThread = nil end
				createGlowLabel("STW farm started.", Color3.fromRGB(0, 150, 255), Color3.fromRGB(100, 200, 255))
				task.spawn(stwFarmCycle)
			end
	
		elseif cmd == "stwfarm off" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			if not stwFarming then
				createGlowLabel("STW farm is not running.", Color3.fromRGB(180, 180, 0), Color3.fromRGB(255, 255, 100))
			else
				stwFarming = false; arrowFarming = false; fishing = false
				clearESP()
				createGlowLabel("STW farm stopped.", Color3.fromRGB(180, 0, 0), Color3.fromRGB(255, 80, 80))
			end
	
		elseif cmd == "eject" then
			script.Parent.Parent:Destroy()
	
		else
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			createGlowLabel("'" .. text .. "': command not found. Type 'help'", Color3.fromRGB(180, 0, 0), Color3.fromRGB(255, 80, 80))
		end
	end
	
	-- =====================================================================
	-- INPUT LISTENER
	-- =====================================================================
	
	input.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			local text = input.Text
			if text ~= "" then
				handleCommand(text)
				input.Text = ""
			end
		end
	end)
	
	-- =====================================================================
	-- INIT
	-- =====================================================================
	
	startSellTimer()
	print("=== 1006 Terminal Loaded ===")
	
end
coroutine.wrap(AGGLN_fake_script)()
