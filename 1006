		local startTime = os.clock()
		while arrowFarming do
			if not root.Parent then return false end
			local alpha = math.clamp((os.clock() - startTime) / ARROW_TWEEN_DURATION, 0, 1)
			local smooth = alpha * alpha * (3 - 2 * alpha)
			root.CFrame = CFrame.new(start:Lerp(position, smooth))
			if alpha >= 1 then break end
			task.wait(0.05)
		end
		return arrowFarming
	end
	
	local function arrowFarmCycle()
		while arrowFarming do
			updateArrowTargets()
			local list = {}
			for _, t in ipairs(arrowTargets) do
				if t.name == ARROW_TARGET_TYPE and t.handle and t.handle.Parent then
					table.insert(list, t)
				end
			end
			if #list == 0 then task.wait(1) continue end
			for _, target in ipairs(list) do
				if not arrowFarming then break end
				if not target.handle.Parent then continue end
				if not arrowMoveTo(target.handle.Position) then break end
				if not arrowFarming then break end
				arrowInteract(target)
				local startWait = os.clock()
				while arrowFarming and os.clock() - startWait < ARROW_WAIT_AT do
					task.wait(0.1)
				end
			end
			task.wait(0.5)
		end
	end
	
	-- Continuous ESP update
	task.spawn(function()
		while true do
			updateArrowTargets()
			updateESP()
			task.wait(0.5)
		end
	end)
	
	-- =====================================================================
	-- TERMINAL COMMAND HANDLER
	-- =====================================================================
	
	local function handleCommand(text)
		local cmd = text:lower()
	
		-- CLEAR
		if cmd == "clear" or cmd == "cls" then
			clearOutput()
			createGlowLabel("cleared!", Color3.fromRGB(0, 200, 100), Color3.fromRGB(180, 255, 220))
	
			-- HELP
		elseif cmd == "help" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			createOutputLabel("------------------------------", Color3.fromRGB(60, 60, 60))
			createGlowLabel("Available commands:", Color3.fromRGB(180, 180, 0), Color3.fromRGB(255, 255, 0))
			createOutputLabel("  help            - shows this help menu")
			createOutputLabel("  clear / cls     - clears the terminal")
			createOutputLabel("  1006            - displays info about 1006")
			createOutputLabel("  own             - shows ownership info")
			createOutputLabel("  autofishing     - starts auto fishing")
			createOutputLabel("  autofishing stop- stops auto fishing")
			createOutputLabel("  autosell        - sells all fish now")
			createOutputLabel("  arrowfarm       - starts stand arrow farm")
			createOutputLabel("  arrowfarm off   - stops stand arrow farm")
			createOutputLabel("------------------------------", Color3.fromRGB(60, 60, 60))
	
			-- 1006
		elseif cmd == "1006" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			createOutputLabel("------------------------------", Color3.fromRGB(60, 60, 60))
			createGlowLabel("[ 1006 ]", Color3.fromRGB(0, 180, 50), Color3.fromRGB(0, 255, 70))
			createOutputLabel("SCP-1006 Terminal System")
			createOutputLabel("Version 1.0.0")
			createGlowLabel("Status: ONLINE", Color3.fromRGB(0, 180, 50), Color3.fromRGB(0, 255, 70))
			createOutputLabel("------------------------------", Color3.fromRGB(60, 60, 60))
	
			-- OWN
		elseif cmd == "own" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			createOutputLabel("------------------------------", Color3.fromRGB(60, 60, 60))
			createGlowLabel("Ownership Info:", Color3.fromRGB(180, 180, 0), Color3.fromRGB(255, 255, 0))
			createOutputLabel("  User: " .. localPlayer.Name)
			createOutputLabel("  UserId: " .. localPlayer.UserId)
			createGlowLabel("  Access Level: root", Color3.fromRGB(200, 100, 0), Color3.fromRGB(255, 180, 50))
			createOutputLabel("------------------------------", Color3.fromRGB(60, 60, 60))
	
			-- AUTOFISHING START
		elseif cmd == "autofishing" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			if fishing then
				createGlowLabel("autofishing is already on.", Color3.fromRGB(180, 180, 0), Color3.fromRGB(255, 255, 100))
			else
				fishing = true
				if fishThread then task.cancel(fishThread) end
				fishThread = task.spawn(fishCycle)
				startSellTimer()
				createGlowLabel("autofishing on", Color3.fromRGB(0, 180, 50), Color3.fromRGB(0, 255, 70))
			end
	
			-- AUTOFISHING STOP
		elseif cmd == "autofishing stop" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			if not fishing then
				createGlowLabel("autofishing is already off.", Color3.fromRGB(180, 180, 0), Color3.fromRGB(255, 255, 100))
			else
				fishing = false
				if fishThread then task.cancel(fishThread) fishThread = nil end
				if sellThread then task.cancel(sellThread) sellThread = nil end
				createGlowLabel("autofishing stopped.", Color3.fromRGB(180, 0, 0), Color3.fromRGB(255, 80, 80))
			end
	
			-- AUTOSELL
		elseif cmd == "autosell" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			if isSelling then
				createGlowLabel("already selling...", Color3.fromRGB(180, 180, 0), Color3.fromRGB(255, 255, 100))
			else
				createGlowLabel("selling all items now...", Color3.fromRGB(0, 150, 255), Color3.fromRGB(100, 200, 255))
				task.spawn(function()
					sellAllItems()
					createGlowLabel("sell complete!", Color3.fromRGB(0, 180, 50), Color3.fromRGB(0, 255, 70))
				end)
			end
	
			-- ARROWFARM START
		elseif cmd == "arrowfarm" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			if arrowFarming then
				createGlowLabel("arrowfarm is already running.", Color3.fromRGB(180, 180, 0), Color3.fromRGB(255, 255, 100))
			else
				arrowFarming = true
				if arrowThread then task.cancel(arrowThread) end
				arrowThread = task.spawn(arrowFarmCycle)
				createGlowLabel("arrowfarm started.", Color3.fromRGB(0, 150, 255), Color3.fromRGB(100, 200, 255))
			end
	
			-- ARROWFARM STOP
		elseif cmd == "arrowfarm off" then
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			if not arrowFarming then
				createGlowLabel("arrowfarm is not running.", Color3.fromRGB(180, 180, 0), Color3.fromRGB(255, 255, 100))
			else
				arrowFarming = false
				if arrowThread then task.cancel(arrowThread) arrowThread = nil end
				createGlowLabel("arrowfarm stopped.", Color3.fromRGB(180, 0, 0), Color3.fromRGB(255, 80, 80))
			end
	
			-- UNKNOWN
		else
			createOutputLabel("root@" .. localPlayer.Name .. ":~$ " .. text)
			createGlowLabel("'" .. text .. "': command not found. Type 'help'", Color3.fromRGB(180, 0, 0), Color3.fromRGB(255, 80, 80))
		end
	end
	
	-- =====================================================================
	-- INPUT LISTENER
	-- =====================================================================
	
	input.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			local text = input.Text
			if text ~= "" then
				handleCommand(text)
				input.Text = ""
			end
		end
	end)
end
